# Postgres. Locally: `pnpm db:local` starts an in-process Postgres on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Auth.js session secret: `openssl rand -base64 32`
AUTH_SECRET=

# OrangeCat OIDC client (the only sign-in in production)
ORANGECAT_OAUTH_CLIENT_ID=
ORANGECAT_OAUTH_CLIENT_SECRET=
# ORANGECAT_OAUTH_ISSUER=https://orangecat.ch

# Comma-separated OIDC subs with access to /ops
SKIF_OPS_SUBS=

# Local development only: enables a sign-in form taking any identity.
# Ignored unless NODE_ENV=development (i.e. `pnpm dev`).
SKIF_DEV_LOGIN=1

# Behind the reverse proxy in production
# AUTH_URL=https://skif.orangecat.ch
# AUTH_TRUST_HOST=true
