# Postgres. Locally: `pnpm db:local` starts an in-process Postgres on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Auth.js session secret: `openssl rand -base64 32`
AUTH_SECRET=

# OrangeCat OIDC client (the only sign-in in production)
ORANGECAT_OAUTH_CLIENT_ID=
ORANGECAT_OAUTH_CLIENT_SECRET=
# ORANGECAT_OAUTH_ISSUER=https://orangecat.ch

# Comma-separated OIDC subs with access to /ops
SKIF_OPS_SUBS=

# Local development only: enables a sign-in form taking any identity.
# Ignored unless NODE_ENV=development (i.e. `pnpm dev`).
SKIF_DEV_LOGIN=1

# Behind the reverse proxy in production
# AUTH_URL=https://skif.orangecat.ch
# AUTH_TRUST_HOST=true

# Operations alerts by email (mail-kit over Resend). Skif stores nobody's email
# address, so mail goes to Operations only and carries no personal or location
# data — just what happened, a booking reference and a link to /ops.
# Unset or placeholder → alerts are skipped quietly; /api/health says mail: unconfigured.
# Comma-separated Ops addresses
SKIF_OPS_EMAIL=
RESEND_API_KEY=
# Optional; defaults to Skif <skif@fleetcrown.orangecat.ch> (the fleet's verified domain)
# RESEND_FROM=Skif <skif@fleetcrown.orangecat.ch>

# AI form assistance (Protector application only). Any ONE key lights it up;
# set more for fallback across vendors. With none, GET /api/health reports
# "ai": "unconfigured" and the form says so and works by hand.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Optional: the model to start the chain at (it still falls back past it).
# SKIF_AI_MODEL=
