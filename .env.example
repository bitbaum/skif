# Postgres. Locally: `pnpm db:local` starts an in-process Postgres on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Session secret, 32+ characters: `openssl rand -base64 32`
# (BETTER_AUTH_SECRET works too)
AUTH_SECRET=

# "Continue with OrangeCat": shown only when both are set
ORANGECAT_OAUTH_CLIENT_ID=
ORANGECAT_OAUTH_CLIENT_SECRET=
# ORANGECAT_OAUTH_ISSUER=https://orangecat.ch

# The shared bitbaum sign-in (Morulia): shown only when all three are set
# SIGNIN_ISSUER=
# SIGNIN_CLIENT_ID=
# SIGNIN_CLIENT_SECRET=

# Comma-separated actor ids with access to /ops: an OrangeCat sub for a person
# who came in through OrangeCat, the account id for everyone else
SKIF_OPS_SUBS=

# Comma-separated actor ids (the owner) whose browser loads the Loki widget
# inside the app too, so Loki's watch mode sees the app in use. Their own
# pages only, never /ops. Unset → the app loads no third-party script.
SKIF_LOKI_WATCH_SUBS=

# Behind the reverse proxy in production
# AUTH_URL=https://skif.orangecat.ch
# AUTH_TRUST_HOST=true

# Mail (mail-kit over Resend): account mail (the emailed sign-in link and
# recovery are offered only with it) and Operations alerts. Alerts go to
# Operations only and carry no personal or location data — just what
# happened, a booking reference and a link to /ops.
# Unset or placeholder → no account mail, alerts are skipped quietly;
# /api/health says mail: unconfigured.
# Comma-separated Ops addresses
SKIF_OPS_EMAIL=
RESEND_API_KEY=
# Optional; defaults to Skif <skif@fleetcrown.orangecat.ch> (the fleet's verified domain)
# RESEND_FROM=Skif <skif@fleetcrown.orangecat.ch>

# Mail people send to hello@skif.orangecat.ch. The box's mail gateway posts it,
# signed, to /api/mail/inbound; it lands in the Operations inbox (/ops) and is
# deleted after MAIL_RETENTION_DAYS (src/config/mail.ts). The secret is a fleet
# key in /opt/fleet/env, shared with the gateway — never set it per app.
# Unset → deliveries are refused; /api/health says inbox: unconfigured.
# MAIL_INBOUND_SECRET=
# Optional; the public address. Defaults to hello@<host of AUTH_URL>.
# MAIL_ADDRESS=hello@skif.orangecat.ch

# AI form assistance (Protector application only). Any ONE key lights it up;
# set more for fallback across vendors. With none, GET /api/health reports
# "ai": "unconfigured" and the form says so and works by hand.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Optional: the model to start the chain at (it still falls back past it).
# SKIF_AI_MODEL=
